# Token do bot, criado no @BotFather
TELEGRAM_BOT_TOKEN=

# Ids dos chats que recebem o envio diário e podem usar o bot (separe por vírgula).
# Se ficar vazio, o bot responde a qualquer um e loga o id do chat no console.
TELEGRAM_CHAT_ID=

# Opcional. Padrão: todo dia às 10:00 (fuso America/Sao_Paulo).
# Para testar, dispara a cada 2 minutos:
#CRON_SCHEDULE=*/2 * * * *
